{
  "manifest_version": 3,
  "name": "WHEB CRM",
  "version": "1.1.0",
  "description": "Quick access to your WHEB CRM tasks and clients",
  "permissions": ["cookies", "storage", "alarms", "sidePanel", "tabs"],
  "host_permissions": [
    "https://wheb-crm.vercel.app/*",
    "https://gederjleajrtqvgcdiyp.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WHEB CRM",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
