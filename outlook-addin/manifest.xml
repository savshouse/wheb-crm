<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:type="MailApp">

  <!-- Replace this GUID with your own if you clone the add-in -->
  <Id>a8f9b234-1c6d-4e87-a231-b8f9c345d678</Id>
  <Version>1.0.0</Version>
  <ProviderName>WHEB</ProviderName>
  <DefaultLocale>en-GB</DefaultLocale>
  <DisplayName DefaultValue="WHEB CRM" />
  <Description DefaultValue="View client information and create tasks directly from your inbox." />

  <!--
    REPLACE "YOUR_APP_URL" with your deployed Next.js URL, e.g.:
      https://wheb-crm.vercel.app
    The URL must be HTTPS.
  -->
  <IconUrl DefaultValue="https://YOUR_APP_URL/favicon.ico" />
  <HighResolutionIconUrl DefaultValue="https://YOUR_APP_URL/favicon.ico" />
  <SupportUrl DefaultValue="https://YOUR_APP_URL" />

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://YOUR_APP_URL/outlook" />
        <RequestedHeight>350</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadItem</Permissions>

  <!-- Activates when reading any email -->
  <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />

</OfficeApp>
