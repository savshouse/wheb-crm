<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:type="MailApp">
  <Id>d3a8f2e1-4b7c-4f9a-b2d1-8e5c3f6a0b9d</Id>
  <Version>1.0.0</Version>
  <ProviderName>Warren House Employee Benefits</ProviderName>
  <DefaultLocale>en-GB</DefaultLocale>
  <DisplayName DefaultValue="WHEB CRM" />
  <Description DefaultValue="Look up clients and manage tasks directly from Outlook emails and meetings." />
  <IconUrl DefaultValue="https://wheb-crm.vercel.app/icons/icon-192.png" />
  <HighResolutionIconUrl DefaultValue="https://wheb-crm.vercel.app/icons/icon-512.png" />
  <SupportUrl DefaultValue="https://wheb-crm.vercel.app" />
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1" />
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://wheb-crm.vercel.app/outlook-addin" />
        <RequestedHeight>280</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Read" />
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
</OfficeApp>
